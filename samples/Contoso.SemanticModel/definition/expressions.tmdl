		    Source = Sql.Database("contoso.database.windows.net", "SalesDW"),
		    dbo_DimCustomer = Source{[Schema="dbo",Item="DimCustomer"]}[Data],
		    #"Renamed Columns" = Table.RenameColumns(dbo_DimCustomer,{{"CustKey", "CustomerKey"}, {"FullName", "Customer Name"}})
		in
		    #"Renamed Columns"

